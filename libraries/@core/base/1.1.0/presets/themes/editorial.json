{
  "slug": "editorial",
  "kind": "theme",
  "summary": "Cinematic editorial: charcoal, serif display type, warm gold accent",
  "tags": [
    "theme",
    "serif",
    "cinematic",
    "luxury"
  ],
  "params": {
    "accent": {
      "type": "color",
      "default": "#e2b866"
    }
  },
  "body": {
    "tokens": {
      "color": {
        "bg": "#111111",
        "bg2": "#1c1a17",
        "surface": "#24211c",
        "fg": "#f1ece2",
        "muted": "#a59d8f",
        "accent": "{{accent}}",
        "accent2": "#c4553a",
        "accent3": "#7fa58b",
        "line": "#f1ece21f"
      },
      "font": {
        "display": "'Playfair Display', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "body": "'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "mono": "'JetBrains Mono', Consolas, 'Courier New', monospace"
      },
      "weight": {
        "display": 700,
        "heading": 600,
        "body": 400
      },
      "size": {
        "hero": 200,
        "h1": 128,
        "h2": 88,
        "h3": 60,
        "body": 40,
        "small": 30,
        "label": 24
      },
      "space": {
        "margin": 140,
        "xs": 12,
        "s": 24,
        "m": 48,
        "l": 96
      },
      "radius": {
        "s": 8,
        "m": 18,
        "l": 36
      },
      "ease": {
        "in": "in",
        "out": "out",
        "inOut": "inOut",
        "snap": "cubic(0.2,0.9,0.1,1)",
        "smooth": "cubic(0.45,0,0.2,1)",
        "spring": "spring(0.35)",
        "bounce": "outBack"
      },
      "dur": {
        "fast": 0.3,
        "base": 0.6,
        "slow": 1.0
      },
      "fx": {
        "glow": "transparent"
      }
    },
    "fonts": [
      {
        "family": "Playfair Display",
        "source": "google",
        "weights": [
          400,
          700,
          800
        ]
      },
      {
        "family": "Inter",
        "source": "google",
        "weights": [
          400,
          500,
          700
        ]
      },
      {
        "family": "JetBrains Mono",
        "source": "google",
        "weights": [
          400,
          700
        ]
      }
    ]
  }
}
