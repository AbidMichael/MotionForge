{
  "slug": "light",
  "kind": "theme",
  "summary": "Light, airy editorial look: warm off-white background, ink type, cobalt accent",
  "tags": [
    "theme",
    "light",
    "clean"
  ],
  "params": {
    "accent": {
      "type": "color",
      "default": "#2f54eb"
    }
  },
  "body": {
    "tokens": {
      "color": {
        "bg": "#f6f4ef",
        "bg2": "#ebe7dd",
        "surface": "#ffffff",
        "fg": "#15171c",
        "muted": "#5d6270",
        "accent": "{{accent}}",
        "accent2": "#ff6a3d",
        "accent3": "#12b886",
        "line": "#15171c1f"
      },
      "font": {
        "display": "'Space Grotesk', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "body": "'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "mono": "'JetBrains Mono', Consolas, 'Courier New', monospace"
      },
      "weight": {
        "display": 800,
        "heading": 700,
        "body": 400
      },
      "size": {
        "hero": 200,
        "h1": 128,
        "h2": 88,
        "h3": 60,
        "body": 40,
        "small": 30,
        "label": 24
      },
      "space": {
        "margin": 140,
        "xs": 12,
        "s": 24,
        "m": 48,
        "l": 96
      },
      "radius": {
        "s": 8,
        "m": 18,
        "l": 36
      },
      "ease": {
        "in": "in",
        "out": "out",
        "inOut": "inOut",
        "snap": "cubic(0.2,0.9,0.1,1)",
        "smooth": "cubic(0.45,0,0.2,1)",
        "spring": "spring(0.35)",
        "bounce": "outBack"
      },
      "dur": {
        "fast": 0.3,
        "base": 0.6,
        "slow": 1.0
      },
      "fx": {
        "glow": "transparent"
      }
    },
    "fonts": [
      {
        "family": "Space Grotesk",
        "source": "google",
        "weights": [
          400,
          700,
          800
        ]
      },
      {
        "family": "Inter",
        "source": "google",
        "weights": [
          400,
          500,
          700
        ]
      },
      {
        "family": "JetBrains Mono",
        "source": "google",
        "weights": [
          400,
          700
        ]
      }
    ]
