{
  "slug": "crossfade",
  "kind": "transition",
  "summary": "Classic dissolve between scenes",
  "tags": [
    "transition",
    "fade",
    "dissolve",
    "soft"
  ],
  "duration": {
    "default": 0.6
  },
  "body": {
    "out": {
      "tracks": {
        "opacity": [
          1,
          0
        ]
      },
      "ease": "inOut"
    },
    "in": {
      "tracks": {
        "opacity": [
          0,
          1
        ]
      },
      "ease": "inOut"
    }
  }
}
