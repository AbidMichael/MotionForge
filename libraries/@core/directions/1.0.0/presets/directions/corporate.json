{
  "slug": "corporate",
  "kind": "direction",
  "summary": "Clean corporate: light theme, measured pace, slide pushes, soft clicks",
  "tags": [
    "direction",
    "look",
    "style",
    "corporate",
    "business",
    "clean",
    "b2b"
  ],
  "params": {
